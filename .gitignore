# This repo is a full, restorable backup of the playable mod — binary game assets
# (gfx/sound/map bitmaps) ARE tracked on purpose. Only local cruft is ignored.

# Python cache from tools/
__pycache__/
*.pyc

# OS cruft
Thumbs.db
desktop.ini
.DS_Store
/tmp
console_history.txt

# simtest — generated & user-specific
tools/simtest/reports/
tools/simtest/test_saves/
tools/simtest/baselines/
tools/simtest/last_run.log
