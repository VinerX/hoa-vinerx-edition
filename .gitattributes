# Mark binary game assets as binary so git never tries to diff/normalize them.
# Text files are left to git's defaults (repo has core.autocrlf=false, so line
# endings are preserved as-is — no mass rewrite of script files).

*.dds  binary
*.tga  binary
*.bmp  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.cur  binary
*.psd  binary
*.ogg  binary
*.wav  binary
*.mp3  binary
*.bank binary
*.mesh binary
*.anim binary
*.ttf  binary
*.otf  binary
*.spr  binary
*.7z   binary
*.zip  binary
